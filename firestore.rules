// firestore.rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* -------------------- USERS -------------------- */
    match /users/{userId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && !exists(/databases/$(database)/documents/users/$(userId));

      allow update, delete: if request.auth != null
        && request.auth.uid == userId;
    }

    /* -------------------- FRIEND REQUESTS -------------------- */
    match /users/{uid}/friendRequests/{reqId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.fromUid;

      // címzett olvashat/törölhet
      allow read, delete: if request.auth != null
        && request.auth.uid == uid;

      // küldő olvashatja a saját req doc-ját (ID = sender uid)
      allow read: if request.auth != null
        && request.auth.uid == reqId;
    }

    /* -------------------- FRIENDS -------------------- */
    match /users/{uid}/friends/{friendUid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && (request.auth.uid == uid || request.auth.uid == friendUid);
      allow delete: if request.auth != null
        && (request.auth.uid == uid || request.auth.uid == friendUid);
    }

    /* -------------------- NOTIFICATIONS -------------------- */
    match /notifications/{notifId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.senderId;
      allow read: if request.auth != null
        && request.auth.uid == resource.data.receiverId;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.receiverId;
    }

    /* -------------------- POSTS -------------------- */
    match /posts/{postId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.createdByUid;

      allow update: if request.auth != null && (
        request.auth.uid == resource.data.createdByUid ||
        request.resource.data.diff(resource.data).changedKeys().hasOnly(["likes"])
      );

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.createdByUid;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.auth.uid == request.resource.data.createdByUid;
        allow delete: if request.auth != null
          && request.auth.uid == resource.data.createdByUid;
      }
    }

    /* -------------------- EVENTS -------------------- */
    match /events/{eventId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.createdByUid;

      allow update: if request.auth != null && (
        request.auth.uid == resource.data.createdByUid ||
        request.resource.data.diff(resource.data).changedKeys().hasOnly(["likes"])
      );

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.createdByUid;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.auth.uid == request.resource.data.createdByUid;
        allow delete: if request.auth != null
          && request.auth.uid == resource.data.createdByUid;
      }
    }

    /* -------------------- MARKETPLACE -------------------- */
    match /marketplace/{listingId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.createdByUid;

      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.createdByUid;
    }

/* -------------------- CHAT / CONVERSATIONS -------------------- */
match /conversations/{convId} {
  // olvasás: csak résztvevők
  allow read: if request.auth != null
    && request.auth.uid in resource.data.participants;

  // létrehozás: auth uid szerepeljen participants-ben (lista)
  allow create: if request.auth != null
    && request.resource.data.participants is list
    && request.auth.uid in request.resource.data.participants;

  // módosítás/törlés: csak résztvevők
  // engedjük lastMessage, updatedAt, name, photoURL és participants frissítését is
  allow update: if request.auth != null
    && request.auth.uid in resource.data.participants
    && request.resource.data.diff(resource.data).changedKeys().hasOnly([
      "lastMessage", "updatedAt", "name", "photoURL", "participants"
    ]);

  allow delete: if request.auth != null
    && request.auth.uid in resource.data.participants;

  // üzenetek
  match /messages/{msgId} {
    function convParticipants() {
      return get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
    }

    // olvasás: csak résztvevők
    allow read: if request.auth != null
      && request.auth.uid in convParticipants();

    // létrehozás: a küldő legyen a résztvevők között
    // kötelező mezők: senderId, type ("text"|"image"|"video"), text vagy mediaUrl, createdAt, readBy lista
    allow create: if request.auth != null
      && request.auth.uid == request.resource.data.senderId
      && request.resource.data.senderId in convParticipants()
      && request.resource.data.type in ["text", "image", "video"]
      && (
        (request.resource.data.type == "text" && request.resource.data.text is string) ||
        ((request.resource.data.type == "image" || request.resource.data.type == "video") && request.resource.data.mediaUrl is string)
      )
      && request.resource.data.readBy is list;

    // frissítés: kizárólag readBy módosítása (olvasottra állítás)
    allow update: if request.auth != null
      && request.auth.uid in convParticipants()
      && request.resource.data.diff(resource.data).changedKeys().hasOnly(["readBy"]);

    // törlés: csak a küldő törölhet
    allow delete: if request.auth != null
      && request.auth.uid == resource.data.senderId;
  }
}
  }
}