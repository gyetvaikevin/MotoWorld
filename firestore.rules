rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* -------------------- USERS -------------------- */
    match /users/{userId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && !exists(/databases/$(database)/documents/users/$(userId));

      allow update, delete: if request.auth != null
        && request.auth.uid == userId;
    }

    /* -------------------- FRIEND REQUESTS -------------------- */
    match /users/{uid}/friendRequests/{reqId} {
      // létrehozás: a küldő írhatja, fromUid == auth.uid
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.fromUid;

      // olvasás/törlés: csak a címzett (uid) láthatja és törölheti
      allow read, delete: if request.auth != null
        && request.auth.uid == uid;

      // PLUSZ: a küldő olvashatja a saját request doc-ját (doc ID = sender uid)
      allow read: if request.auth != null
        && request.auth.uid == reqId;
    }

    /* -------------------- FRIENDS -------------------- */
    match /users/{uid}/friends/{friendUid} {
      // csak a saját barátlistádat olvashatod
      allow read: if request.auth != null && request.auth.uid == uid;

      // létrehozás: engedjük a saját uid-nak ÉS a friendUid-nak is
      allow create: if request.auth != null
        && (request.auth.uid == uid || request.auth.uid == friendUid);

      // törlés: ugyanígy, bármelyik fél törölheti a kapcsolatot
      allow delete: if request.auth != null
        && (request.auth.uid == uid || request.auth.uid == friendUid);
    }

    /* -------------------- NOTIFICATIONS -------------------- */
    match /notifications/{notifId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.senderId;
      allow read: if request.auth != null
        && request.auth.uid == resource.data.receiverId;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.receiverId;
    }

    /* -------------------- POSTS -------------------- */
    match /posts/{postId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.createdByUid;

      allow update: if request.auth != null && (
        request.auth.uid == resource.data.createdByUid ||
        request.resource.data.diff(resource.data).changedKeys().hasOnly(["likes"])
      );

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.createdByUid;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.auth.uid == request.resource.data.createdByUid;
        allow delete: if request.auth != null
          && request.auth.uid == resource.data.createdByUid;
      }
    }

    /* -------------------- EVENTS -------------------- */
    match /events/{eventId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.createdByUid;

      allow update: if request.auth != null && (
        request.auth.uid == resource.data.createdByUid ||
        request.resource.data.diff(resource.data).changedKeys().hasOnly(["likes"])
      );

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.createdByUid;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.auth.uid == request.resource.data.createdByUid;
        allow delete: if request.auth != null
          && request.auth.uid == resource.data.createdByUid;
      }
    }

    /* -------------------- MARKETPLACE -------------------- */
    match /marketplace/{listingId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.createdByUid;

      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.createdByUid;
    }

    /* -------------------- CHAT / CONVERSATIONS -------------------- */
    match /conversations/{convId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;

      allow create: if request.auth != null
        && request.resource.data.participants is list
        && request.auth.uid in request.resource.data.participants;

      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants;

      allow delete: if request.auth != null
        && request.auth.uid in resource.data.participants;

      match /messages/{msgId} {
        function convParticipants() {
          return get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        }

        allow read: if request.auth != null
          && request.auth.uid in convParticipants();

        allow create: if request.auth != null
          && request.auth.uid == request.resource.data.senderId
          && request.resource.data.senderId in convParticipants()
          && request.resource.data.receiverId in convParticipants()
          && request.resource.data.text is string;

        allow update: if request.auth != null
          && request.auth.uid in convParticipants()
          && request.auth.uid == resource.data.receiverId
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(["read"]);

        allow delete: if request.auth != null
          && request.auth.uid == resource.data.senderId;
      }
    }
  }
}
